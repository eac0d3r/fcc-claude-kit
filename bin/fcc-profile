#!/usr/bin/env python3
"""fcc-profile: model profiles for Free Claude Code (FCC) + a Claude Code launcher.

Profiles live in ~/.config/fcc-profile/profiles/<name>.json (no secrets).
The FCC server is the source of truth for routing; `use` applies a profile via
POST /admin/api/config/apply. API keys stay only in ~/.fcc/.env.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

CONFIG_DIR = Path(os.environ.get("FCC_PROFILE_HOME", Path.home() / ".config" / "fcc-profile"))
PROFILES_DIR = CONFIG_DIR / "profiles"
ACTIVE_FILE = CONFIG_DIR / "active"
FCC_ENV = Path.home() / ".fcc" / ".env"
TIERS = ("opus", "sonnet", "haiku", "fable")
EFFORTS = ("inherit", "client", "off", "low", "medium", "high", "xhigh", "max")
PROVIDER_TAG = {"nvidia_nim": "NIM", "open_router": "OR", "github_copilot": "Copilot"}
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,47}$")


def die(msg: str, code: int = 1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


# ---------- FCC server ----------

def fcc_env() -> dict[str, str]:
    env: dict[str, str] = {}
    if FCC_ENV.exists():
        for line in FCC_ENV.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                env[k.strip()] = v.strip().strip("'\"")
    return env


def base_url() -> str:
    return f"http://127.0.0.1:{fcc_env().get('PORT', '8082')}"


def api(path: str, payload: dict | None = None, timeout: float = 10):
    req = urllib.request.Request(
        base_url() + path,
        data=None if payload is None else json.dumps(payload).encode(),
        headers={"content-type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)


def server_up() -> bool:
    try:
        return api("/health", timeout=2).get("status") == "healthy"
    except (OSError, ValueError):
        return False


def ensure_server():
    if server_up():
        return
    binary = shutil.which("fcc-server") or die("fcc-server not found in PATH")
    print("starting fcc-server in the background...", file=sys.stderr)
    subprocess.Popen(
        [binary], start_new_session=True, stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        env={**os.environ, "FCC_OPEN_BROWSER": "0"},
    )
    for _ in range(60):
        if server_up():
            return
        time.sleep(0.5)
    die("fcc-server did not respond within 30s (see ~/.fcc/logs/)")


def available_models() -> list[str]:
    return api("/admin/api/models", timeout=60)["models"]


# ---------- profiles ----------

def profile_path(name: str) -> Path:
    if not NAME_RE.match(name):
        die(f"invalid name: {name!r} (use letters, digits, . _ -)")
    return PROFILES_DIR / f"{name}.json"


def load(name: str) -> dict:
    p = profile_path(name)
    if not p.exists():
        die(f"profile does not exist: {name}")
    return validate(json.loads(p.read_text()), name)


def validate(prof: dict, name: str = "?") -> dict:
    def chk_effort(e, where):
        if e not in EFFORTS:
            die(f"{name}: invalid effort in {where}: {e!r} (use {', '.join(EFFORTS)})")

    if not isinstance(prof.get("model"), str) or "/" not in prof["model"]:
        die(f"{name}: 'model' is required in provider/model format")
    chk_effort(prof.setdefault("effort", "client"), "effort")
    for t, spec in prof.setdefault("tiers", {}).items():
        if t not in TIERS:
            die(f"{name}: unknown tier {t!r} (use {', '.join(TIERS)})")
        if not isinstance(spec.get("model"), str) or "/" not in spec["model"]:
            die(f"{name}: tiers.{t}.model must be provider/model")
        chk_effort(spec.setdefault("effort", "inherit"), f"tiers.{t}.effort")
    return prof


def save(name: str, prof: dict):
    PROFILES_DIR.mkdir(parents=True, exist_ok=True)
    profile_path(name).write_text(json.dumps(validate(prof, name), indent=2, ensure_ascii=False) + "\n")


def names() -> list[str]:
    return sorted(p.stem for p in PROFILES_DIR.glob("*.json")) if PROFILES_DIR.exists() else []


def active() -> str | None:
    return ACTIVE_FILE.read_text().strip() if ACTIVE_FILE.exists() else None


def auto_alias(model: str) -> str:
    provider, _, rest = model.partition("/")
    return f"{rest.rsplit('/', 1)[-1]} · {PROVIDER_TAG.get(provider, provider)}"


def alias_for(prof: dict, tier: str) -> str:
    spec = prof["tiers"].get(tier)
    return (spec or {}).get("alias") or auto_alias((spec or prof)["model"])


def parse_spec(text: str) -> dict:
    """MODEL[@EFFORT][=ALIAS]"""
    alias = None
    if "=" in text:
        text, alias = text.split("=", 1)
    effort = "high"
    if "@" in text:
        text, effort = text.rsplit("@", 1)
    spec = {"model": text, "effort": effort}
    if alias:
        spec["alias"] = alias
    return spec


def materialize(prof: dict):
    """Write to the file what `run` would infer: all tiers and an alias with the real model name."""
    for t in ("opus", "sonnet", "haiku", "fable"):
        # fable repeats opus when not given
        default = prof["tiers"].get("opus") if t == "fable" else None
        spec = prof["tiers"].setdefault(t, dict(default) if default else {"model": prof["model"], "effort": prof["effort"]})
        spec.setdefault("alias", auto_alias(spec["model"]))


def apply(prof: dict):
    missing = [m for m in {prof["model"], *(s["model"] for s in prof["tiers"].values())}
               if m not in available_models()]
    if missing:
        die("models unavailable in FCC: " + ", ".join(missing)
            + "\n(use `fcc-profile models <filter>` to list available ones)")
    values = {"MODEL": prof["model"], "REASONING_POLICY": prof["effort"]}
    for t in TIERS:
        spec = prof["tiers"].get(t)
        values[f"MODEL_{t.upper()}"] = spec["model"] if spec else None
        values[f"REASONING_{t.upper()}"] = spec["effort"] if spec else "inherit"
    res = api("/admin/api/config/apply", {"values": values})
    if res.get("pending_fields"):
        print(f"warning: fcc-server restart required: {res['pending_fields']}", file=sys.stderr)


# ---------- comandos ----------

def cmd_list(_):
    cur = active()
    for n in names():
        p = load(n)
        print(f"{'*' if n == cur else ' '} {n:20} {p['model']}")
    if not names():
        print("(no profiles; use `fcc-profile new`)")


def cmd_show(a):
    print(json.dumps(load(a.name), indent=2, ensure_ascii=False))
    print("\ndisplayed alias:", {t: alias_for(load(a.name), t) for t in ("opus", "sonnet", "haiku")})


def cmd_new(a):
    if profile_path(a.name).exists() and not a.force:
        die(f"already exists: {a.name} (use --force to overwrite)")
    base = parse_spec(a.model)
    prof = {"model": base["model"], "effort": base["effort"], "tiers": {}}
    for t in TIERS:
        if getattr(a, t):
            prof["tiers"][t] = parse_spec(getattr(a, t))
    materialize(prof)
    validate(prof, a.name)
    if server_up():
        avail = set(available_models())
        bad = [m for m in {prof["model"], *(s["model"] for s in prof["tiers"].values())} if m not in avail]
        if bad:
            die("models unavailable in FCC: " + ", ".join(bad))
    save(a.name, prof)
    print(f"created: {a.name}  (activate with `fcc-profile use {a.name}`)")


def cmd_edit(a):
    p = profile_path(a.name)
    if not p.exists():
        die(f"profile does not exist: {a.name}")
    before = p.read_text()
    subprocess.call([*os.environ.get("EDITOR", "vi").split(), str(p)])
    try:
        validate(json.loads(p.read_text()), a.name)
    except (ValueError, SystemExit):
        p.write_text(before)
        die("invalid JSON/schema; change reverted")
    if active() == a.name:
        print("active profile changed; run `fcc-profile use %s` to re-apply" % a.name)


def cmd_rm(a):
    p = profile_path(a.name)
    if not p.exists():
        die(f"profile does not exist: {a.name}")
    if active() == a.name and not a.force:
        die("this is the active profile; activate another first or use --force")
    p.unlink()
    if active() == a.name:
        ACTIVE_FILE.unlink()
    print(f"removed: {a.name}")


def cmd_use(a):
    prof = load(a.name)
    ensure_server()
    apply(prof)
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    ACTIVE_FILE.write_text(a.name + "\n")
    print(f"active: {a.name}")


def cmd_current(_):
    cur = active()
    print("active profile:", cur or "(none)")
    if server_up():
        vals = {f["key"]: f["value"] for f in api("/admin/api/config")["fields"]
                if f["key"].startswith(("MODEL", "REASONING_"))}
        print("server:", base_url())
        print("  MODEL ", vals.get("MODEL"), f"[{vals.get('REASONING_POLICY')}]")
        for t in TIERS:
            m = vals.get(f"MODEL_{t.upper()}")
            if m:
                print(f"  {t:6}", m, f"[{vals.get('REASONING_' + t.upper())}]")
    else:
        print("server: stopped")


def cmd_models(a):
    ensure_server()
    for m in available_models():
        if not a.filter or all(f.lower() in m.lower() for f in a.filter):
            print(m)


def tier_model_id(prof: dict, tier: str) -> str:
    """Model id sent to FCC and shown by Claude Code (header, statusline).

    FCC routes by substring (fable > opus > haiku > sonnet); the alias goes in the id and the
    tier name at the end. Earlier-tier words inside the alias get a ZWSP so they do not hijack routing.
    """
    slug = re.sub(r"[^A-Za-z0-9._:]+", "-", alias_for(prof, tier)).strip("-")
    order = ("fable", "opus", "haiku", "sonnet")
    for word in order[: order.index(tier)]:  # fable, opus, haiku are matched before sonnet
        slug = re.sub(word, lambda m: m.group(0)[0] + "\u200b" + m.group(0)[1:], slug, flags=re.I)
    return f"{slug}-{tier}"


def claude_env(prof: dict | None, name: str | None) -> dict[str, str]:
    cfg = fcc_env()
    env = {k: v for k, v in os.environ.items()
           if not k.startswith("ANTHROPIC_") and k != "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"}
    env.update({
        "ANTHROPIC_BASE_URL": base_url(),
        "ANTHROPIC_AUTH_TOKEN": cfg.get("ANTHROPIC_AUTH_TOKEN", "freecc"),
        "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "0",  # otherwise /model lists the whole FCC catalog
        "CLAUDE_CODE_AUTO_MODE_SERVER": "0",
        "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
        "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "190000",
        "DISABLE_AUTOUPDATER": "1",
        "DISABLE_FEEDBACK_COMMAND": "1",
        "DISABLE_ERROR_REPORTING": "1",
        # Effort is decided by the profile (REASONING_*). Otherwise Claude Code appends a
        # role=system message that the native Copilot path in FCC rejects (HTTP 400).
        "CLAUDE_CODE_EFFORT_LEVEL": "unset",
        # Tool search injects text blocks into tool_result that NVIDIA NIM rejects (HTTP 422).
        "ENABLE_TOOL_SEARCH": "false",
        "FCC_PROFILE": name or "",
    })
    if prof:
        for t in ("opus", "sonnet", "haiku", "fable"):
            model = (prof["tiers"].get(t) or prof)["model"]
            env[f"ANTHROPIC_DEFAULT_{t.upper()}_MODEL"] = tier_model_id(prof, t)
            env[f"ANTHROPIC_DEFAULT_{t.upper()}_MODEL_DESCRIPTION"] = model
        env["FCC_MODEL_OPUS"] = alias_for(prof, "opus")
        env["FCC_MODEL_SONNET"] = alias_for(prof, "sonnet")
        env["FCC_MODEL_HAIKU"] = alias_for(prof, "haiku")
    return env


def cmd_run(a):
    claude = shutil.which("claude") or die("claude not found in PATH")
    name = a.profile or active()
    prof = load(name) if name else None
    ensure_server()
    if a.profile:
        apply(prof)
        ACTIVE_FILE.write_text(name + "\n")
    elif prof is None:
        print("warning: no active profile; using the current FCC mapping", file=sys.stderr)
    os.execvpe(claude, [claude, *a.args], claude_env(prof, name))


def cmd_doctor(_):
    ok = True

    def check(label, good, detail=""):
        nonlocal ok
        ok &= bool(good)
        print(f"[{'ok' if good else '!!'}] {label}" + (f": {detail}" if detail else ""))

    check("claude in PATH", shutil.which("claude"), shutil.which("claude") or "")
    check("fcc-server in PATH", shutil.which("fcc-server"))
    up = server_up()
    check("FCC server responding", up, base_url())
    cfg = fcc_env()
    check("HOST restricted to loopback", cfg.get("HOST") == "127.0.0.1",
          f"HOST={cfg.get('HOST', '0.0.0.0 (default, exposed to the network)')}")
    state, _ = patch_state()
    check("native.py patch (Copilot)", state == "applied", f"{state} (run `fcc-profile patch`)" if state != "applied" else "")
    cop = shutil.which("copilot")
    ver = subprocess.run([cop, "--version"], capture_output=True, text=True).stdout if cop else ""
    check("Copilot CLI 1.0.83", "1.0.83" in ver, ver.strip().splitlines()[0] if ver else "missing")
    if up:
        avail = set(available_models())
        for n in names():
            p = load(n)
            bad = [m for m in {p["model"], *(s["model"] for s in p["tiers"].values())} if m not in avail]
            check(f"profile {n}", not bad, "unavailable: " + ", ".join(bad) if bad else "models ok")
    sys.exit(0 if ok else 1)


# ---------- FCC patch and initial setup ----------

PATCH_OLD = """            if messages:
                raise NativeMessagesError(
                    "Native Messages supports only leading system messages."
                )
            content = raw["content"]"""
PATCH_NEW = """            # fcc-profile patch: Claude Code sends system messages after the user turn;
            # the Messages API only has the `system` field, so they are promoted to it.
            content = raw["content"]"""


def native_py() -> Path | None:
    uv = shutil.which("uv")
    if not uv:
        return None
    tools = Path(subprocess.run([uv, "tool", "dir"], capture_output=True, text=True).stdout.strip())
    found = sorted((tools / "free-claude-code" / "lib").glob("python*/site-packages/free_claude_code/core/anthropic/native.py"))
    return found[0] if found else None


def patch_state() -> tuple[str, Path | None]:
    path = native_py()
    if path is None:
        return "missing", None
    text = path.read_text()
    if PATCH_NEW in text:
        return "applied", path
    return ("pending" if PATCH_OLD in text else "incompatible"), path


def cmd_patch(a):
    """Accept late system messages in FCC's native path (required for Copilot)."""
    state, path = patch_state()
    if a.check:
        print(f"patch: {state}")
        sys.exit(0 if state == "applied" else 1)
    if state == "missing":
        die("FCC not found in `uv tool dir` (run install.sh)")
    if state == "incompatible":
        die(f"{path}: expected snippet not found; the FCC version changed. Review the patch before applying")
    backup = CONFIG_DIR / "native.py.orig"
    text = path.read_text()
    if a.revert:
        if state != "applied":
            die("patch is not applied")
        path.write_text(text.replace(PATCH_NEW, PATCH_OLD))
        print("patch reverted; restart fcc-server")
        return
    if state == "applied":
        print("patch already applied")
        return
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if not backup.exists():
        backup.write_text(text)
    path.write_text(text.replace(PATCH_OLD, PATCH_NEW))
    print(f"patch applied to {path}; restart fcc-server if it is running")


def cmd_init(_):
    """Ensure HOST=127.0.0.1 in ~/.fcc/.env (FCC defaults to 0.0.0.0, exposed to the network)."""
    FCC_ENV.parent.mkdir(parents=True, exist_ok=True)
    if not FCC_ENV.exists():
        FCC_ENV.write_text("# Managed by Free Claude Code.\nFCC_CONFIG_SCHEMA=2\n")
        FCC_ENV.chmod(0o600)
    text = FCC_ENV.read_text()
    if re.search(r"^HOST=", text, re.M):
        print("HOST already set in", FCC_ENV)
        return
    FCC_ENV.write_text(text.rstrip("\n") + "\nHOST=127.0.0.1\n")
    print("HOST=127.0.0.1 written to", FCC_ENV, "(takes effect on the next fcc-server start)")


def main():
    ap = argparse.ArgumentParser(prog="fcc-profile", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list", help="list profiles").set_defaults(f=cmd_list)
    s = sub.add_parser("show", help="show a profile"); s.add_argument("name"); s.set_defaults(f=cmd_show)
    s = sub.add_parser("new", help="create a profile", epilog="spec = provider/model[@effort][=alias]")
    s.add_argument("name"); s.add_argument("--model", required=True, help="default model (MODEL)")
    for t in TIERS:
        s.add_argument(f"--{t}", metavar="SPEC")
    s.add_argument("--force", action="store_true"); s.set_defaults(f=cmd_new)
    s = sub.add_parser("edit", help="edit in $EDITOR"); s.add_argument("name"); s.set_defaults(f=cmd_edit)
    s = sub.add_parser("rm", help="delete a profile"); s.add_argument("name"); s.add_argument("--force", action="store_true"); s.set_defaults(f=cmd_rm)
    s = sub.add_parser("use", help="activate a profile in FCC"); s.add_argument("name"); s.set_defaults(f=cmd_use)
    sub.add_parser("current", help="active profile and real mapping").set_defaults(f=cmd_current)
    s = sub.add_parser("models", help="list available models"); s.add_argument("filter", nargs="*"); s.set_defaults(f=cmd_models)
    s = sub.add_parser("run", help="run Claude Code through FCC")
    s.add_argument("-p", "--profile"); s.add_argument("args", nargs=argparse.REMAINDER); s.set_defaults(f=cmd_run)
    sub.add_parser("doctor", help="diagnostics").set_defaults(f=cmd_doctor)
    s = sub.add_parser("patch", help="apply/check the FCC patch needed for Copilot")
    s.add_argument("--check", action="store_true"); s.add_argument("--revert", action="store_true"); s.set_defaults(f=cmd_patch)
    sub.add_parser("init", help="safe initial FCC setup (loopback HOST)").set_defaults(f=cmd_init)
    a = ap.parse_args()
    if getattr(a, "args", None) and a.args[:1] == ["--"]:
        a.args = a.args[1:]
    a.f(a)


if __name__ == "__main__":
    try:
        main()
    except urllib.error.URLError as e:
        die(f"failed to reach FCC: {e.reason}")
